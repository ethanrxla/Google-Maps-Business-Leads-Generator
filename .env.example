# =============================================================================
# Leads Pipeline - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# -- Google Places API (required for collection) --
GOOGLE_API_KEY=your_google_api_key_here

# -- Supabase (required for pipeline database) --
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# -- Hunter.io (optional, used for email verification) --
HUNTER_API_KEY=your_hunter_api_key_here
HUNTER_BASE_URL=https://api.hunter.io/v2

# -- Apollo.io (optional, used for org enrichment) --
APOLLO_API_KEY=your_apollo_api_key_here
APOLLO_BASE_URL=https://api.apollo.io/api/v1

# -- Stripe (required for payments) --
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_MODE=test
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY_TEST=sk_test_...

# -- Frontend --
FRONTEND_BASE_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# -- Optional enrichment APIs --
BUILTWITH_API_KEY=
SCRAPINGBEE_API_KEY=
FIRECRAWL_API_KEY=
BRIGHT_DATA_API_KEY=

# -- Optional AI APIs --
OPENAI_API_KEY=
GEMINI_API_KEY=

# -- Optional OSINT APIs --
VIRUSTOTAL_API_KEY=
GITHUB_API_KEY=
SERP_API_KEY=
NETLAS_API_KEY=

# -- Crypto payments (optional) --
COINBASE_API_KEY=
COINBASE_SECRET=
